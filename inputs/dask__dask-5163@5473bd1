  d1 = time()-t;print('A:',d1);t=time()
  
  Rb = B(R2)
  matrixB = Rb
  d2 = time()-t;print('B:',d2);t=time()
  if not d0:
    d0 = d2
  
  print('Ratio between A & B', round(d2/d1))
