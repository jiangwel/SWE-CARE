   unset LE_PYTHON
   DeterminePythonVersion "NOCRASH"
-  if [ "$PYVER" -eq 26 ]; then
+  # Starting to Fedora 29, python2 is on a deprecation path. Let's move to python3 then.
+  RPM_DIST_NAME=`(source /etc/os-release && echo $ID) || echo "unknown"`
+  RPM_DIST_VERSION=`(source /etc/os-release && echo $VERSION_ID) || echo "0"`
