+
+    def to_spec(self) -> "URLDataset":
+        return URLDataset.from_dict(self.to_dict())
+
+
+Spec = Union[DVCXDataset, DVCDataset, URLDataset]
+Lock = Union[DVCXDatasetLock, DVCDatasetLock, URLDatasetLock]
+
+
+@frozen(kw_only=True)
+class Dataset:
+    manifest_path: str
+    spec: Spec
