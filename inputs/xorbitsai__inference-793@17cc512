+  const endPoint = getEndpoint()
+
+  const removeToken = () => {
+    removeCookie('token', { path: '/' })
+  }
+
+  useEffect(() => {
+    // token possible value: no_auth / need_auth / <real bearer token>
+    fetch(endPoint + '/v1/cluster/auth', {
+      method: 'GET',
