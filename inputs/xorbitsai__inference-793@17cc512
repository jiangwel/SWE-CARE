+          {msg}
+        </Alert>
+      </Snackbar>
       <HashRouter>
         <ThemeProvider theme={theme}>
           <ApiContextProvider>
             <CssBaseline />
+            <AuthAlertDialog />
             <Routes>
+              <Route path="/login" element={<Login />} />
               <Route element={<Layout />}>
                 <Route path="/" element={<LaunchModel />} />
                 <Route path="/running_models" element={<RunningModels />} />
